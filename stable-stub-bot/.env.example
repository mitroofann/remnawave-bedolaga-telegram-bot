# ===== Бот-заглушка старого бота (Stable VPN → Bulka VPN) =====

# СТАРЫЙ токен бота (тот же, что был у основного старого бота).
BOT_TOKEN=8667265065:AAEQxZezRmzRV41h-t1duCVKG4knFPWJLvA

# Username НОВОГО бота без @ (для кнопки «Открыть Bulka VPN»).
BULKA_BOT_USERNAME=vpnbulka_bot

# Путь к логотипу Bulka VPN внутри контейнера (положи файл в assets/).
BULKA_LOGO_PATH=assets/bulka_logo.png

# Админы для команды /broadcast (через запятую).
ADMIN_IDS=216332351,161893461,7250836069

# Та же БД, что у основного бота (нужна только для /broadcast).
# Прямой asyncpg-DSN. Если в основном .env postgresql+asyncpg://... — тут можно так же,
# бот сам уберёт "+asyncpg". Хватает прав на чтение таблицы users.
DATABASE_URL=postgresql://remnawave_user:secure_password_123@postgres:5432/remnawave_bot

# Скорость рассылки (сообщений/сек). Telegram лимит ~30, 20 — с запасом.
BROADCAST_RATE=20
